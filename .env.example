# Copy to .env and replace the placeholders. docker compose reads .env automatically.

# Static admin token for /admin/* and /delegations (v1 only; at least 24 characters).
# Generate one with: openssl rand -hex 32
BROKER_ADMIN_TOKEN=replace-with-a-long-random-string

POSTGRES_PASSWORD=replace-with-a-database-password

# The broker's public URL. Tokens carry it as `iss`, so it must match what the Orders API expects.
BROKER_ISSUER=http://broker:9000
